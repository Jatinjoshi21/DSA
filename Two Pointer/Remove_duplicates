class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
       int i = 0;
       int j = 1;
       int k = 1;
       while(j<nums.size()){
        if(nums[j]!=nums[j-1]){
            i++;
            k++;
            nums[i]=nums[j];
        }
        j++;
        
       }
       return k; 
    }
};